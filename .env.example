# Retrieval mode: demo is dependency-light; full uses Milvus + Elasticsearch
RAG_MODE=demo

# Optional in demo; required in full. Keep the value blank in committed files.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Trust-boundary and generation limits
RAG_QUERY_MAX_CHARS=500
RAG_TOP_K_MAX=10
RAG_CONTEXT_MAX_CHARS=12000
RAG_GENERATION_MAX_TOKENS=512
RAG_REQUEST_TIMEOUT_SECONDS=60
RAG_DEMO_FIXTURE_PATH=demo/fixtures/cuda_docs.json
RAG_RESULT_DIR=result

# Full-mode hybrid retrieval
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=Test_collection
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=documents
